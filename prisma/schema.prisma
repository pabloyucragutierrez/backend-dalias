generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  nombre    String   @default("")
  apellido  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blog[]
  
  @@map("users")
}

model Blog {
  id                Int      @id @default(autoincrement())
  titulo            String
  descripcionCorta  String   @db.Text
  descripcion       String   @db.LongText
  imagen            String?
  imagePublicId     String?
  estado            String   @default("activo")
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("blogs")
  @@index([userId])
}

model Actividad {
  id             Int      @id @default(autoincrement())
  titulo         String
  subtitulo      String   @default("")
  descripcion    String   @db.Text
  imagen         String?
  imagePublicId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("actividades")
}

model Visita {
  id                  Int      @id @default(autoincrement())
  nombreApellido      String
  correoElectronico   String
  edadAdultoMayor     Int
  nivelDependencia    String
  observacionesSalud  String?  @db.Text
  fechaSeleccionada   String
  horaSeleccionada    String
  evaluacion          Json?
  estado              String   @default("pendiente")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@map("visitas")
  @@unique([fechaSeleccionada, horaSeleccionada])
}